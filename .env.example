# Copy to .env.local for local development. On Vercel, add these under Project Settings > Environment Variables.
# Never commit real values.

# Public site address, no trailing slash (used for links and to check where form posts come from)
NEXT_PUBLIC_SITE_URL=https://example.com

# WhatsApp number in international format, digits only (e.g. 9733XXXXXXX). Leave empty to hide WhatsApp buttons.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# WhatsApp number of the demo assistant, digits only. Leave empty to hide the live demo section.
NEXT_PUBLIC_DEMO_WHATSAPP_NUMBER=

# Public contact email shown on the site. Leave empty to hide it.
NEXT_PUBLIC_CONTACT_EMAIL=

# Contact form delivery through Zoho transactional email (ZeptoMail). Server-side only, keep secret.
ZEPTOMAIL_API_KEY=
# Inbox that receives the messages
CONTACT_TO_EMAIL=
# Sender address on your verified domain, e.g. website@yourdomain.com
CONTACT_FROM_EMAIL=
